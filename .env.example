PORT=3000

# GitHub
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_USERNAME=your_username

# Fitness APIs (choose your providers)
# Fitbit
FITBIT_ACCESS_TOKEN=your_fitbit_token

# Strava
STRAVA_ACCESS_TOKEN=your_strava_token

# Apple Health (via HealthKit export or third-party)
# APPLE_HEALTH_API_KEY=your_key

# Sleep tracking
# Oura Ring
OURA_ACCESS_TOKEN=your_oura_token

# Whoop
# WHOOP_ACCESS_TOKEN=your_whoop_token

# Other integrations
# Spotify
SPOTIFY_ACCESS_TOKEN=your_spotify_token

# RescueTime
RESCUETIME_API_KEY=your_rescuetime_key
